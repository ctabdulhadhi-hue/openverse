# ---------------------------------------------------------------
# OPENVERSE .gitignore
# ---------------------------------------------------------------

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js / build output
.next/
out/
build/
dist/
functions/lib/

# testing
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# environment / secrets — NEVER commit real values
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
!.env.example
*.pem
functions/.secret.local
functions/.runtimeconfig.json
service-account*.json

# firebase (future)
.firebase/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# typescript
*.tsbuildinfo
next-env.d.ts

# editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# vercel
.vercel
