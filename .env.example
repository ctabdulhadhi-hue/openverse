# =================================================================
# OPENVERSE — environment variable template
# =================================================================
# Copy to `.env.local` for local development. NEVER commit real values.
#
# Status (Phase 0): NONE of these are used by the app yet.
# They are documented placeholders for future phases.
#
# Rules:
#  - Variables prefixed with NEXT_PUBLIC_ are embedded into the browser
#    bundle and are PUBLIC. Only put non-secret values there.
#  - Firebase *web* config is public by design; it is protected by
#    Firestore/Storage Security Rules and App Check (Phase 24/29).
#  - Server secrets (e.g. GEMINI_API_KEY) must NEVER use NEXT_PUBLIC_
#    and must NEVER be read by client code.
# =================================================================

# --- Firebase web config (PLANNED — Phase 24) --------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Use the local Firebase Emulator Suite instead of production (PLANNED — Phase 24)
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# --- Gemini (PLANNED — Phase 22) ---------------------------------
# SERVER-ONLY. Not read by the Next.js app at all.
# In production this lives in Google Secret Manager and is accessed by
# Cloud Functions via defineSecret("GEMINI_API_KEY").
# For local emulator development it goes in functions/.secret.local
# (git-ignored), NOT in this file.
# GEMINI_API_KEY=
